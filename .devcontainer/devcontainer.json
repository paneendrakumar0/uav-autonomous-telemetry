{
  "name": "UAV Slung-Payload SITL (Gazebo Classic)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-python.python",
        "ms-iot.vscode-ros",
        "redhat.vscode-xml"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "C_Cpp.default.intelliSenseMode": "linux-gcc-x64",
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "ros.distro": "humble"
      }
    }
  },
  "postCreateCommand": "cd /root/ros2_ws && source /opt/ros/humble/setup.bash && source /root/px4_msgs_ws/install/setup.bash && colcon build --packages-select uav_control",
  "remoteUser": "root",
  "runArgs": [
    "--network=host",
    "--privileged"
  ],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "PX4_HOME": "/root/PX4-Autopilot"
  }
}
