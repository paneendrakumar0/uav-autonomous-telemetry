#!/usr/bin/env python3

import csv
import math
import socket
import struct
from pathlib import Path

import rclpy
from geometry_msgs.msg import Vector3Stamped
from px4_msgs.msg import VehicleLocalPosition
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, HistoryPolicy, QoSProfile, ReliabilityPolicy


class PayloadSwingLogger(Node):
    def __init__(self):
        super().__init__("payload_swing_logger")

        self.declare_parameter("output_path", "payload_swing_metrics.csv")
        self.declare_parameter("listen_ip", "127.0.0.1")
        self.declare_parameter("listen_port", 7001)
        self.declare_parameter("timer_period_s", 0.01)
        self.declare_parameter("vehicle_pose_index", 0)
        self.declare_parameter("payload_pose_index", 1)
        self.declare_parameter("cable_direction_topic", "/uav_control/payload_cable_direction")
        self.declare_parameter("cable_direction_rate_topic", "/uav_control/payload_cable_direction_rate")
        self.declare_parameter("direction_rate_filter_hz", 3.0)
        self.declare_parameter(
            "disturbance_estimate_topic", "/uav_control/estimated_disturbance_acceleration"
        )
        self.declare_parameter(
            "payload_correction_topic", "/uav_control/payload_swing_correction"
        )

        output_path = Path(
            self.get_parameter("output_path").get_parameter_value().string_value
        ).expanduser()
        output_path.parent.mkdir(parents=True, exist_ok=True)
        self.csv_file = output_path.open("w", newline="")
        self.writer = csv.writer(self.csv_file)
        self.writer.writerow(
            [
                "t_s",
                "uav_x_m",
                "uav_y_m",
                "uav_z_gazebo_m",
                "payload_x_m",
                "payload_y_m",
                "payload_z_m",
                "cable_dx_m",
                "cable_dy_m",
                "cable_dz_m",
                "cable_length_m",
                "lateral_swing_m",
                "cable_angle_deg",
                "pose_source",
                "cable_q_n",
                "cable_q_e",
                "cable_q_d",
                "cable_qdot_n_s",
                "cable_qdot_e_s",
                "cable_qdot_d_s",
                "disturbance_ax_n_m_s2",
                "disturbance_ay_e_m_s2",
                "payload_correction_ax_n_m_s2",
                "payload_correction_ay_e_m_s2",
            ]
        )

        self.latest_uav = None
        self.last_cable_direction = None
        self.last_cable_direction_time_s = None
        self.filtered_cable_direction_rate = (0.0, 0.0, 0.0)
        self.latest_disturbance_estimate = (0.0, 0.0, 0.0)
        self.latest_payload_correction = (0.0, 0.0, 0.0)
        self.samples = 0
        self.start_time_ns = self.get_clock().now().nanoseconds

        qos = QoSProfile(
            reliability=ReliabilityPolicy.BEST_EFFORT,
            durability=DurabilityPolicy.TRANSIENT_LOCAL,
            history=HistoryPolicy.KEEP_LAST,
            depth=1,
        )
        controller_telemetry_qos = QoSProfile(
            reliability=ReliabilityPolicy.BEST_EFFORT,
            durability=DurabilityPolicy.VOLATILE,
            history=HistoryPolicy.KEEP_LAST,
            depth=10,
        )
        self.create_subscription(
            VehicleLocalPosition,
            "/fmu/out/vehicle_local_position",
            self.vehicle_local_position_callback,
            qos,
        )
        cable_direction_topic = (
            self.get_parameter("cable_direction_topic").get_parameter_value().string_value
        )
        cable_direction_rate_topic = (
            self.get_parameter("cable_direction_rate_topic").get_parameter_value().string_value
        )
        self.direction_rate_filter_hz = (
            self.get_parameter("direction_rate_filter_hz").get_parameter_value().double_value
        )
        self.cable_direction_pub = self.create_publisher(
            Vector3Stamped, cable_direction_topic, qos
        )
        self.cable_direction_rate_pub = self.create_publisher(
            Vector3Stamped, cable_direction_rate_topic, qos
        )
        disturbance_estimate_topic = (
            self.get_parameter("disturbance_estimate_topic").get_parameter_value().string_value
        )
        payload_correction_topic = (
            self.get_parameter("payload_correction_topic").get_parameter_value().string_value
        )
        self.create_subscription(
            Vector3Stamped,
            disturbance_estimate_topic,
            self.disturbance_estimate_callback,
            controller_telemetry_qos,
        )
        self.create_subscription(
            Vector3Stamped,
            payload_correction_topic,
            self.payload_correction_callback,
            controller_telemetry_qos,
        )

        listen_ip = self.get_parameter("listen_ip").get_parameter_value().string_value
        listen_port = self.get_parameter("listen_port").get_parameter_value().integer_value
        self.vehicle_pose_index = (
            self.get_parameter("vehicle_pose_index").get_parameter_value().integer_value
        )
        self.payload_pose_index = (
            self.get_parameter("payload_pose_index").get_parameter_value().integer_value
        )
        self.sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        self.sock.bind((listen_ip, listen_port))
        self.sock.setblocking(False)

        timer_period = (
            self.get_parameter("timer_period_s").get_parameter_value().double_value
        )
        self.create_timer(timer_period, self.poll_udp)
        self.get_logger().info(
            f"Logging payload swing metrics to {output_path} from UDP {listen_ip}:{listen_port}"
        )

    def vehicle_local_position_callback(self, msg):
        if not (math.isfinite(msg.x) and math.isfinite(msg.y) and math.isfinite(msg.z)):
            return
        self.latest_uav = (float(msg.x), float(msg.y), -float(msg.z))

    def disturbance_estimate_callback(self, msg):
        values = (float(msg.vector.x), float(msg.vector.y), float(msg.vector.z))
        if all(math.isfinite(value) for value in values):
            self.latest_disturbance_estimate = values

    def payload_correction_callback(self, msg):
        values = (float(msg.vector.x), float(msg.vector.y), float(msg.vector.z))
        if all(math.isfinite(value) for value in values):
            self.latest_payload_correction = values

    def poll_udp(self):
        while True:
            try:
                data, _ = self.sock.recvfrom(2048)
            except BlockingIOError:
                break
            poses = self.parse_poses(data)
            if poses is None:
                continue

            payload_pose = self.pose_at_index(poses, self.payload_pose_index)
            vehicle_pose = self.pose_at_index(poses, self.vehicle_pose_index)
            if payload_pose is None and len(poses) == 1:
                payload_pose = poses[0]

            if payload_pose is None:
                continue

            if vehicle_pose is not None and len(poses) > 1:
                self.write_sample(vehicle_pose, payload_pose, "gazebo_link_pair")
            elif self.latest_uav is not None:
                self.write_sample(self.latest_uav, payload_pose, "px4_local_fallback")

    def parse_poses(self, data):
        header_size = 8
        if len(data) < header_size:
            return None

        _, name_size = struct.unpack_from("<II", data, 0)
        poses_count_offset = header_size + name_size
        if len(data) < poses_count_offset + 4:
            return None

        (poses_count,) = struct.unpack_from("<I", data, poses_count_offset)
        if poses_count < 1:
            return None

        pose_offset = poses_count_offset + 4
        pose_format = "<I4xdddddd"
        pose_size = struct.calcsize(pose_format)
        if len(data) < pose_offset + poses_count * pose_size:
            return None

        poses = []
        for i in range(poses_count):
            offset = pose_offset + i * pose_size
            _element_id, x, y, z, _pitch, _yaw, _roll = struct.unpack_from(
                pose_format, data, offset
            )
            if math.isfinite(x) and math.isfinite(y) and math.isfinite(z):
                poses.append((x, y, z))
            else:
                poses.append(None)
        return poses

    @staticmethod
    def pose_at_index(poses, index):
        if index < 0 or index >= len(poses):
            return None
        return poses[index]

    def write_sample(self, vehicle_pose, payload_pose, pose_source):
        uav_x, uav_y, uav_z = vehicle_pose
        payload_x, payload_y, payload_z = payload_pose
        dx = payload_x - uav_x
        dy = payload_y - uav_y
        dz = payload_z - uav_z
        lateral = math.hypot(dx, dy)
        cable_length = math.sqrt(dx * dx + dy * dy + dz * dz)
        angle_deg = math.degrees(math.atan2(lateral, abs(dz)))
        t_s = (self.get_clock().now().nanoseconds - self.start_time_ns) * 1e-9

        cable_direction_ned = (math.nan, math.nan, math.nan)
        cable_direction_rate_ned = (math.nan, math.nan, math.nan)
        if pose_source == "gazebo_link_pair" and cable_length > 1e-6:
            # Gazebo world vectors are ENU; PX4 local control uses NED.
            # ENU (east, north, up) -> NED (north, east, down).
            cable_direction_ned = (
                dy / cable_length,
                dx / cable_length,
                -dz / cable_length,
            )
            self.publish_payload_state(cable_direction_ned, t_s)
            cable_direction_rate_ned = self.filtered_cable_direction_rate

        self.writer.writerow(
            [
                f"{t_s:.6f}",
                f"{uav_x:.6f}",
                f"{uav_y:.6f}",
                f"{uav_z:.6f}",
                f"{payload_x:.6f}",
                f"{payload_y:.6f}",
                f"{payload_z:.6f}",
                f"{dx:.6f}",
                f"{dy:.6f}",
                f"{dz:.6f}",
                f"{cable_length:.6f}",
                f"{lateral:.6f}",
                f"{angle_deg:.6f}",
                pose_source,
                *(f"{value:.6f}" for value in cable_direction_ned),
                *(f"{value:.6f}" for value in cable_direction_rate_ned),
                f"{self.latest_disturbance_estimate[0]:.6f}",
                f"{self.latest_disturbance_estimate[1]:.6f}",
                f"{self.latest_payload_correction[0]:.6f}",
                f"{self.latest_payload_correction[1]:.6f}",
            ]
        )
        self.samples += 1
        if self.samples % 100 == 0:
            self.csv_file.flush()

    def publish_payload_state(self, cable_direction_ned, t_s):
        rate = (0.0, 0.0, 0.0)
        if self.last_cable_direction is not None and self.last_cable_direction_time_s is not None:
            dt_s = t_s - self.last_cable_direction_time_s
            if 1e-4 < dt_s < 0.2:
                raw_rate = tuple(
                    (current - previous) / dt_s
                    for current, previous in zip(cable_direction_ned, self.last_cable_direction)
                )
                alpha = 1.0 - math.exp(
                    -2.0 * math.pi * max(0.0, self.direction_rate_filter_hz) * dt_s
                )
                rate = tuple(
                    previous + alpha * (current - previous)
                    for previous, current in zip(self.filtered_cable_direction_rate, raw_rate)
                )

        self.last_cable_direction = cable_direction_ned
        self.last_cable_direction_time_s = t_s
        self.filtered_cable_direction_rate = rate
        stamp = self.get_clock().now().to_msg()

        direction_msg = Vector3Stamped()
        direction_msg.header.stamp = stamp
        direction_msg.header.frame_id = "local_ned"
        direction_msg.vector.x, direction_msg.vector.y, direction_msg.vector.z = cable_direction_ned
        self.cable_direction_pub.publish(direction_msg)

        rate_msg = Vector3Stamped()
        rate_msg.header.stamp = stamp
        rate_msg.header.frame_id = "local_ned"
        rate_msg.vector.x, rate_msg.vector.y, rate_msg.vector.z = rate
        self.cable_direction_rate_pub.publish(rate_msg)

    def destroy_node(self):
        samples = self.samples
        self.csv_file.flush()
        self.csv_file.close()
        self.sock.close()
        if rclpy.ok():
            self.get_logger().info(f"Payload swing logger wrote {samples} samples")
        super().destroy_node()


def main():
    rclpy.init()
    node = PayloadSwingLogger()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
