<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="slung_payload_ball">
    <link name="link">
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00021</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00021</iyy>
          <iyz>0</iyz>
          <izz>0.00021</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.10</radius>
          </sphere>
        </geometry>
        <surface>
          <collide_bitmask>0</collide_bitmask>
        </surface>
      </collision>
      <visual name="payload_visual">
        <geometry>
          <sphere>
            <radius>0.10</radius>
          </sphere>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Orange</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
      <visual name="cable_visual">
        <pose>0 0 0.5 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.01</radius>
            <length>1.0</length>
          </cylinder>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Black</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
      <gravity>1</gravity>
      <velocity_decay>
        <linear>0.02</linear>
        <angular>0.02</angular>
      </velocity_decay>
    </link>
  </model>
</sdf>
