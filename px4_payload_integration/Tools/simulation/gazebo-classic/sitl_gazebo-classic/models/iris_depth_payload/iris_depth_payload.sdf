<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="iris_depth_payload">
    <include>
      <uri>model://iris</uri>
    </include>

    <include>
      <uri>model://depth_camera</uri>
      <pose>0.1 0 0 0 0 0</pose>
    </include>

    <joint name="depth_camera_joint" type="revolute">
      <child>depth_camera::link</child>
      <parent>iris::base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <upper>0</upper>
          <lower>0</lower>
        </limit>
      </axis>
    </joint>

    <link name="payload_cable">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.0017</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0017</iyy>
          <iyz>0</iyz>
          <izz>0.000001</izz>
        </inertia>
      </inertial>
      <visual name="payload_cable_visual">
        <pose>0 0 -0.5 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.01</radius>
            <length>1.0</length>
          </cylinder>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Black</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
      <gravity>1</gravity>
      <velocity_decay>
        <linear>0.02</linear>
        <angular>0.02</angular>
      </velocity_decay>
    </link>

    <link name="slung_payload">
      <pose>0 0 -1.0 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00021</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00021</iyy>
          <iyz>0</iyz>
          <izz>0.00021</izz>
        </inertia>
      </inertial>
      <collision name="slung_payload_collision">
        <geometry>
          <sphere>
            <radius>0.10</radius>
          </sphere>
        </geometry>
        <surface>
          <collide_bitmask>0</collide_bitmask>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <visual name="slung_payload_visual">
        <geometry>
          <sphere>
            <radius>0.10</radius>
          </sphere>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Orange</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
      <gravity>1</gravity>
      <velocity_decay>
        <linear>0.02</linear>
        <angular>0.02</angular>
      </velocity_decay>
    </link>

    <joint name="payload_mass_joint" type="fixed">
      <parent>payload_cable</parent>
      <child>slung_payload</child>
    </joint>

    <joint name="slung_payload_joint" type="ball">
      <parent>iris::base_link</parent>
      <child>payload_cable</child>
      <pose>0 0 0 0 0 0</pose>
    </joint>

    <plugin name="payload_pose_sniffer" filename="libgazebo_pose_sniffer_plugin.so">
      <pose_receiver_ip>127.0.0.1</pose_receiver_ip>
      <pose_receiver_port>7001</pose_receiver_port>
      <vehicle_name>iris_depth_payload</vehicle_name>
      <tracked_link>slung_payload</tracked_link>
    </plugin>
  </model>
</sdf>
